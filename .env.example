# Supabase 本地開發設定
# 金鑰請勿寫入版本庫；執行 `npx supabase status` 複製 JWT 格式的 anon / service_role。
# 建議 server-side 使用 SUPABASE_URL/SUPABASE_ANON_KEY（runtime 讀取），避免 NEXT_PUBLIC 在 build 時被 inline。
# SUPABASE_URL=http://127.0.0.1:65431
# SUPABASE_ANON_KEY=
#
# 若你需要在 client-side 使用（可選），再另外設定 NEXT_PUBLIC_*。
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:65431
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PIP 自我檢查：true 時允許手動輸入卡號；生產環境請省略或設 false（僅接受讀卡機快速輸入）
# NEXT_PUBLIC_PIP_TEST_MODE=true

# 如果你有後端需要用到萬用權限（選填）
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:65432/postgres

# YCS_SESSION_SECRET="請換成你自己的長密鑰字串（>=32）"